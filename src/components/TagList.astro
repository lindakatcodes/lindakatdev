---
interface Props {
  tags: string[];
  activeTag: string;
  showAll?: boolean;
}

const { tags, activeTag, showAll = true } = Astro.props;

const sanitizedTags = tags.map((tag) => tag.toLowerCase().split(" ").join("-"));

const formattedTags = sanitizedTags.map((tag) => ({
  tag,
  path: `/blog/tags/${tag}`,
}));

if (showAll) {
  formattedTags.unshift({
    tag: "all",
    path: "/blog",
  });
}
---

<p>Browse by topic:</p>
<div>
  {
    formattedTags.map(({ tag, path }) => (
      <a href={path} class={activeTag === tag ? "tag active" : "tag"}>
        {tag}
      </a>
    ))
  }
</div>

<style>
  p {
    text-align: center;
    margin-block-end: 0.5rem;
  }

  div {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin: 0 auto 2.5rem;
    max-inline-size: 40rem;
  }

  .tag {
    border-radius: 0.25rem;
    padding: 0.25rem 0.75rem;
    transition: all 0.2s;
  }
</style>
