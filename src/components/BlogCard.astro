---
import type { CollectionEntry } from "astro:content";

export interface Props {
  postData: CollectionEntry<"blog">;
}

const { postData } = Astro.props;
const { title, description, tags = [] } = postData.data;
---

<li>
  <a href=`/blog/${postData.id}`>
    <h2>{title}</h2>
  </a>
  <p>{description}</p>
  <div class="tags">
    {tags.map((tag) => <p>{tag}</p>)}
  </div>
  <a href=`/blog/${postData.id}`><p>Read more<span> »</span></p></a>
</li>

<style>
  li {
    display: grid;
    grid-template-areas: "title" "desc" "tags" "details";
    gap: 0.75rem;
    margin-block-end: 3rem;
  }

  a {
    text-decoration: none;

    &:hover {
      text-decoration-line: underline;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      background-color: var(--text-main);
      background-image: var(--gradient);
      background-repeat: repeat;
      background-size: 100%;
    }
  }

  h2 {
    font-size: var(--font-size-4xl);
    line-height: 3.5rem;
  }

  p {
    display: inline;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    text-transform: uppercase;

    & p {
      padding: 0.125rem 0.25rem;
      background: var(--text-main);
      color: var(--text-flip);
      font-size: var(--font-size-sm);
      border-radius: 0.125rem;
    }
  }
</style>
