---
import ContactEmail from "@components/ContactEmail.astro";
import ProjectCard from "@components/ProjectCard.astro";
import SocialsGrid from "@components/SocialsGrid.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { DEFAULT_METADATA } from "@util/constants";
import { getCollection } from "astro:content";

const featuredProjects = await getCollection("projects", ({ data }) => {
  return data.featured === true;
});
const orderedProjects = featuredProjects.sort(
  (p1, p2) =>
    new Date(p2.data.lastPublishDate).getTime() -
    new Date(p1.data.lastPublishDate).getTime(),
);
---

<BaseLayout metadata={DEFAULT_METADATA}>
  <section class="splash">
    <h1>Linda Thompson</h1>
    <p>
      A software sorceress, elevating teams through intentional design &
      inclusive code.
    </p>
    <div class="contact-cta">
      <ContactEmail ctaTitle="Let's build something together" />
      <SocialsGrid />
    </div>
  </section>
  <section class="projects">
    <h2>Featured Projects</h2>
    <div class="project-cards">
      {orderedProjects.map((project) => <ProjectCard project={project} />)}
    </div>
    <a href="/projects" class="view-more">See more of my work</a>
  </section>
</BaseLayout>

<style>
  section {
    margin-block-end: 8rem;
  }

  .splash {
    min-block-size: 50vh;
    padding-block-start: 6rem;
    text-align: center;
    display: grid;
    place-items: center;
    gap: 2rem;

    & h1 {
      font-size: clamp(var(--font-size-6xl), 12vw, 8rem);
      font-weight: normal;
    }

    & > p {
      font-size: clamp(var(--font-size-md), 6vw, var(--font-size-xl));
      max-inline-size: 36rem;
    }

    & .contact-cta {
      display: grid;
      justify-content: center;
      gap: 0.5rem;
    }
  }

  .projects {
    container-type: inline-size;

    & h2 {
      text-align: center;
      margin-block-end: 2rem;
    }

    & .project-cards {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      margin-block-end: 2rem;

      @container (min-width: 48rem) {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    & .view-more {
      display: block;
      inline-size: fit-content;
      margin-inline: auto;
      font-size: var(--font-size-xl);
      text-underline-offset: 4px;

      &:hover {
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        background-color: var(--text-main);
        background-image: var(--gradient);
        background-repeat: repeat;
        background-size: 100%;
        transition: background 0.3s ease-in-out;
      }
    }
  }

  @media (min-width: 48rem) {
    .splash {
      gap: 0.5rem;
    }
  }
</style>
