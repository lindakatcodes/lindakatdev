---
import ContactEmail from "@components/ContactEmail.astro";
import ProjectCard from "@components/ProjectCard.astro";
import SocialsGrid from "@components/SocialsGrid.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { DEFAULT_METADATA } from "@util/constants";
import { getCollection } from "astro:content";

const featuredProjects = await getCollection("projects", ({ data }) => {
  return data.featured === true;
});
const orderedProjects = featuredProjects.sort(
  (p1, p2) =>
    new Date(p2.data.lastPublishDate).getTime() -
    new Date(p1.data.lastPublishDate).getTime(),
);
---

<BaseLayout metadata={DEFAULT_METADATA}>
  <section class="splash">
    <h1>Linda Thompson</h1>
    <p>
      A software sorceress, elevating teams through intentional design &
      inclusive code.
    </p>
    <div class="contact-cta">
      <ContactEmail ctaTitle="Let's build something together" />
      <SocialsGrid />
    </div>
  </section>
  <section class="projects">
    <h2>Projects</h2>
    <div class="project-cards">
      {orderedProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>

<style>
  section {
    margin-block-end: 8rem;
    margin-inline: 2rem;
  }

  .splash {
    min-block-size: 50vh;
    padding-block-start: 6rem;
    max-inline-size: 48rem;
    text-align: center;
    display: grid;
    place-items: center;
    gap: 2rem;
    margin-inline: auto;

    & h1 {
      font-family: var(--accent-font);
      font-size: clamp(var(--font-size-6xl), 12vw, 6rem);
      font-weight: normal;
      line-height: 1;
    }

    & p {
      font-size: clamp(var(--font-size-md), 4vw, var(--font-size-lg));
      max-inline-size: 36rem;
    }

    & .contact-cta {
      display: grid;
      justify-content: center;
      gap: 0.5rem;
    }
  }

  .projects {
    container-type: inline-size;
    & h2 {
      text-align: center;
    }

    & .project-cards {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;

      @container (min-width: 48rem) {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  }

  @media (min-width: 48rem) {
    .splash {
      gap: 0.5rem;
    }
  }
</style>
