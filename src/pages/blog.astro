---
import BaseLayout from "@layouts/BaseLayout.astro";
import { DEFAULT_METADATA } from "@util/constants.ts";
import { getCollection } from "astro:content";

const metadata = {
  ...DEFAULT_METADATA,
  title: "Blog | LindaKat Codes",
  description: "Musings, writeups, and things I've learned.",
  url: "https://lindakat.com/blog",
};

const allPosts = await getCollection("blog", ({ data }) => {
  return import.meta.env.DEV ? true : data.status === "Live";
});

const posts = allPosts.sort(
  (a, b) =>
    new Date(b.data.publishedDate).getTime() -
    new Date(a.data.publishedDate).getTime(),
);
---

<BaseLayout metadata={metadata}>
  <h1>Blog</h1>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li class="post-card">
          <a href={`/blog/${post.data.slug}`}>
            <p class="post-date">
              {new Date(post.data.publishedDate).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </p>
            <h2>{post.data.title}</h2>
            <p class="post-description">{post.data.description}</p>
            {post.data.tags && post.data.tags.length > 0 && (
              <ul class="tag-list">
                {post.data.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  h1 {
    text-align: center;
    font-size: var(--font-size-5xl);
    margin-block-end: 2rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 65ch;
    margin-inline: auto;
    margin-block-end: 8rem;
  }

  .post-card a {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1.5rem;
    border: 1px solid var(--color-border, currentColor);
    border-radius: 0.5rem;

    &:hover h2 {
      text-decoration: underline;
    }
  }

  .post-date {
    font-size: var(--font-size-sm, 0.875rem);
    opacity: 0.7;
    margin: 0 0 0.25rem;
  }

  h2 {
    font-size: var(--font-size-2xl, 1.5rem);
    margin: 0 0 0.5rem;
  }

  .post-description {
    margin: 0 0 0.75rem;
  }

  .tag-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: var(--font-size-sm, 0.875rem);
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    opacity: 0.8;
  }
</style>
